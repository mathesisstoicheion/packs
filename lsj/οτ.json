greekLit:tlg0012.tlg001.perseus-grc1:18:599"}," sq.; ",{"g":"ὁτὲ μέν τε . . , ἄλλοτε δὲ"},".. ",{"c":"11.64","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:11:64"},"; ",{"g":"ὁτὲ μὲν . . , ὁτὲ δ' αὖτε"},".. ",{"c":"A.R. 1.1270","u":"urn:cts:greekLit:tlg0001.tlg001.perseus-grc1:1:1270"},"; ",{"g":"ὁτὲ μέν τε . . , ὅτ' αὖ"},".. ",{"c":"Id. 3.1300","u":"urn:cts:greekLit:tlg0001.tlg001.perseus-grc1:3:1300"},"; ",{"g":"ὁτὲ μὲν . . , ποτὲ δὲ"},".. ",{"c":"Plb. 6.20.8","u":"urn:cts:greekLit:tlg0543.tlg001.perseus-grc1:6:20:8"},"; ",{"g":"ὁτὲ μὲν . . , ὁτὲ δὲ . . , καὶ ἄλλοτε"},".. ",{"c":"D.L. 2.106","u":"urn:cts:greekLit:tlg0004.tlg001.perseus-grc1:2:106"},"; ",{"g":"ὁτὲ μὲν . . , πάλιν δὲ"},".. ",{"c":"Arist. EN 1100a28","u":"urn:cts:greekLit:tlg0086.tlg010.perseus-grc1:1100a:28"},"; ",{"g":"ἐνίοτε μὲν . . , ὁτὲ δὲ"},".. ",{"c":"Id. Mete. 360b3","u":"urn:cts:greekLit:tlg0086.tlg026:360b:3"},"; ",{"g":"ὁτὲ μὲν . . , ἢ"},".. ",{"c":"Id. Po. 1448a21","u":"urn:cts:greekLit:tlg0086.tlg034.perseus-grc1:1448a:21"}," (s. v.l.): also reversely, ",{"g":"ἄλλοτε μὲν . . , ὁτὲ δὲ"},".. ",{"c":"Il. 11.568","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:11:568"},"; also ",{"g":"ὁτὲ δέ"}," in the second clause, without any correlative in the first, ",{"c":"17.178","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:17:178"},"; S. joins ",{"g":"ἔσθ' ὅτε . . , ὅτ' ἄλλοτ' ἄλλον"},{"c":"Aj. 56","u":"urn:cts:greekLit:tlg0011.tlg003.perseus-grc1:56"},"; ",{"g":"ὁτὲ δέ"}," alone, at the beginning of a clause, ",{"c":"X. Cyn. 5.8","u":"urn:cts:greekLit:tlg0032.tlg014.perseus-grc1:5:8"}," and ",{"c":"20","u":"urn:cts:greekLit:tlg0032.tlg014.perseus-grc1:20"},", ",{"c":"9.8","u":"urn:cts:greekLit:tlg0032.tlg014.perseus-grc1:9:8"}," and ",{"c":"20","u":"urn:cts:greekLit:tlg0032.tlg014.perseus-grc1:20"},"."]]]},{"k":"o(/te2","s":"","b":[[0,"",[{"g":"ὅτε"},", neut. of ",{"g":"ὅστε"},": also Ion. masc. for ",{"g":"ὅστε"},", "]],[1,"A",[" v. ",{"g":"ὅς, ἥ, ὅ"},"."]]]}],"ὀτεῖος":[{"k":"o)tei=os","s":"","b":[[0,"",[{"g":"ὀτεῖος"},", ",{"g":"α"},", ",{"g":"ον"},", Cret. for ",{"g":"ὁποῖος"},", but in sense, "]],[1,"A",[" = ",{"g":"ὅστις"},", Leg.Gort. 4.52, 5.1, Schwyzer 183.5 (iii B. C.):— Boeot. ",{"g":"ὁτῖος"}," in ",{"g":"μηδοτίη"}," (q. v.); cf. ",{"g":"τεῖος, τέουτος"},"."]]]}],"ὅτεο":[{"k":"o(/teo","s":"","b":[[0,"",[{"g":"ὅτεο"},", ",{"g":"ὁτέοισιν"},", ",{"g":"ὅτευ"},", ",{"g":"ὅτεῳ"},", ",{"g":"ὅτεων"},", Ep. and Ion. cases of ",{"g":"ὅστις"},"."]]]}],"ὄτερος":[{"k":"o)/teros","s":"","b":[[0,"",[{"g":"ὄτερος"},", ",{"g":"α"},", ",{"g":"ον"},", Cret. for ",{"g":"ὁπότερος"},", Leg.Gort. 9.53, SIG 525.11 (iii B. C.). (Cf. Skt. "]],[1,"A",[" yatarás 'which of two' (relat.).)"]]]}],"ὁτῆμος":[{"k":"o(th=mos","s":"","b":[[0,"",[{"g":"ὁτῆμος"},", "]],[1,"A",[" f.l. for ",{"g":"ὁπῆμος"}," in ",{"c":"Herod. 3.55","u":"urn:cts:greekLit:tlg0650.tlg001:3:55"},"."]]]}],"ὅτῐ":[{"k":"o(/ti^","s":"that, with regard to the fact that, not only, although","b":[[0,"",[{"g":"ὅτῐ"},", Ep. ",{"g":"ὅττῐ"}," (both in Hom.): Conj., to introduce an objective clause, "]],[1,"A",[" that, after Verbs of seeing or knowing, thinking or saying; in Hom. freq. strengthd. ",{"g":"ὅτι ῥα"},", and ",{"g":"ὅτι δή"},":—Usage: "]],[2,"I",[" when ",{"g":"ὅτι"}," introduces a statement of fact: "]],[4,"a",[" in Hom. always with ind., the tense following the same rules as in English, ",{"g":"ἤγγειλ' ὅττι ῥά οἱ πόσις ἔκτοθι μίμνε πυλάων"},{"c":"Il. 22.439","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:22:439"},". "]],[4,"b",[" in Att., ",{"g":"ὅτι"}," takes ind. after primary tenses, ind. or opt. after secondary tenses, e.g. ",{"g":"ἐνδείκνυμαι ὅτι οὐκ ἔστι σοφός"},{"c":"Pl. Ap. 23b","u":"urn:cts:greekLit:tlg0059.tlg002.perseus-grc1:23b"},"; ",{"g":"ᾔσθετο ὅτι τὸ Μένωνος στράτευμα ἤδη ἐν Κιλικίᾳ ἦν"},{"c":"X. An. 1.2.21","u":"urn:cts:greekLit:tlg0032.tlg006.perseus-grc1:1:2:21"},", cf. ",{"c":"2.2.15","u":"urn:cts:greekLit:tlg0032.tlg006.perseus-grc1:2:2:15"},", al.; ",{"g":"ἔλεγον ὅτι οὐκ ὀρθῶς αἱ σπονδαὶ γένοιντο"},{"c":"Th. 5.61","u":"urn:cts:greekLit:tlg0003.tlg001.perseus-grc1:5:61"},", cf. ",{"c":"Pl. Phd. 59e","u":"urn:cts:greekLit:tlg0059.tlg004.perseus-grc1:59e"},", etc.; ",{"g":"ἠπείλης' ὅτι . . βαδιοίμην"},{"c":"Ar. Pl. 88","u":"urn:cts:greekLit:tlg0019.tlg011.perseus-grc1:88"},": the ind. is freq. retained in the same tense which the speaker used or would have used, ",{"g":"ἠγγέλθη . . ὅτι Μέγαρα ἀφέστηκε"}," news came that Megara had (lit. has) revolted, ",{"c":"Th. 1.114","u":"urn:cts:greekLit:tlg0003.tlg001.perseus-grc1:1:114"},"; ",{"g":"ἀποκρινάμενοι ὅτι πέμψουσι"}," ib.",{"c":"90","u":"urn:cts:greekLit:tlg0003.tlg001.perseus-grc1:90"},": sts. opt. and ind. are found in the same sentence, ",{"g":"ἔλεγον, ὅτι Κῦρος μὲν τέθνηκεν, Ἀριαῖος δὲ πεφευγὼς . . εἴη"},{"c":"X. An. 2.1.3","u":"urn:cts:greekLit:tlg0032.tlg006.perseus-grc1:2:1:3"},"; ",{"g":"Περικλῆς . . προηγόρευε . . ὅτι Ἀρχίδαμος μέν οἱ ξένος εἴη . . , τοὺς δ' ἀγροὺς τοὺς ἑαυτοῦ καὶ οἰκίας . . , ἀφίησιν αὐτὰ δημόσια εἶναι"},{"c":"Th. 2.13","u":"urn:cts:greekLit:tlg0003.tlg001.perseus-grc1:2:13"},", cf. ",{"c":"Pl. Phd. 61b","u":"urn:cts:greekLit:tlg0059.tlg004.perseus-grc1:61b"},", etc.: also ",{"g":"ὅτι"},".. and the acc. with inf. are found together, ",{"c":"Th. 3.25","u":"urn:cts:greekLit:tlg0003.tlg001.perseus-grc1:3:25"},", ",{"c":"X. Cyr. 1.3.13","u":"urn:cts:greekLit:tlg0032.tlg007.perseus-grc1:1:3:13"},". "]],[3,"2",[" when ",{"g":"ὅτι"}," introduces a conditional sentence, the Constr. after ",{"g":"ὅτι"}," is the same as in independent conditional sentences, ",{"g":"εἴ τις ἔροιτο, καθ' ὁποίους νόμους δεῖ πολιτεύεσθαι, δῆλον ὅτι ἀποκρίναισθ' ἄν"},".. it is manifest that you would answer.., ",{"c":"D. 46.12","u":"urn:cts:greekLit:tlg0014.tlg046.perseus-grc1:12"},", cf. ",{"c":"X. Mem. 1.6.12","u":"urn:cts:greekLit:tlg0032.tlg002.perseus-grc1:1:6:12"},". "]],[2,"II",[{"g":"ὅτι"}," is freq. inserted pleon. in introducing a quotation (where we use no Conj. and put inverted commas), ",{"g":"λόγον τόνδε ἐκφαίνει ὁ Πρωτεύς, λέγων ὅτι ἐγὼ εἰ μὴ περὶ πολλοῦ ἡγεύμην"},".. ",{"c":"Hdt. 2.115","u":"urn:cts:greekLit:tlg0016.tlg001.perseus-grc1:2:115"},"; ",{"g":"καὶ ἐγὼ εἶπον, ὅ. ἡ αὐτή μοι ἀρχή ἐστι"},".. ",{"c":"Pl. Prt. 318a","u":"urn:cts:greekLit:tlg0059.tlg022:318a"},", cf. ",{"c":"356a","u":"urn:cts:greekLit:tlg0059.tlg022:356a"},", ",{"c":"361a","u":"urn:cts:greekLit:tlg0059.tlg022:361a"},", etc.; even where the quotation consists of one word, ib.",{"c":"330c","u":"urn:cts:greekLit:tlg0059.tlg022:330c"},", ",{"c":"Men. 74b","u":"urn:cts:greekLit:tlg0059.tlg024:74b"},", ",{"c":"74c","u":"urn:cts:greekLit:tlg0059.tlg024:74c"},". "]],[3,"2",[{"g":"ὅ"},". is also used pleon. with the inf. and acc. (cf. ",{"g":"ὡς"}," B. I.I), ",{"g":"εἶπον ὅτι πρῶτον ἐμὲ χρῆναι πειραθῆναι κατ' ἐμαυτόν"}," (which is in fact a mixture of two constrr.) Id. Lg. 892d, cf. Phd. 63c, ",{"c":"X. HG 2.2.2","u":"urn:cts:greekLit:tlg0032.tlg001.perseus-grc1:2:2:2"},", etc.; but ",{"g":"ὅτι"}," has freq. been wrongly inserted by the copyists, as if ",{"g":"εἶπεν"}," or ",{"g":"λέγουσιν"}," must be followed by it, as in ",{"c":"Th. 4.37","u":"urn:cts:greekLit:tlg0003.tlg001.perseus-grc1:4:37"}," (om. Pap.), ",{"c":"X. Cyr. 5.4.1","u":"urn:cts:greekLit:tlg0032.tlg007.perseus-grc1:5:4:1"},", etc. "]],[2,"III",[{"g":"ὅτι"}," in Att. freq. represents a whole sentence, esp. in affirm. answers, ",{"g":"οὐκοῦν . . τὸ ἀδικεῖν κάκιον ἂν εἴη τοῦ ἀδικεῖσθαι"},". Answ. ",{"g":"δῆλον δὴ ὅτι"}," (i.e. ",{"g":"ὅτι κάκιον ἂν εἴη"},", or ",{"g":"ὅτι ταῦτα οὕτως ἔχει"},") ",{"c":"Pl. Grg. 475c","u":"urn:cts:greekLit:tlg0059.tlg023:475c"},"; cf. ",{"g":"οἶδ' ὅτι, ἴσθ' ὅτι, οἶσθ' ὅτι"},", ",{"c":"S. Ant. 276","u":"urn:cts:greekLit:tlg0011.tlg002.perseus-grc1:276"},", ",{"c":"758","u":"urn:cts:greekLit:tlg0011.tlg002.perseus-grc1:758"},", ",{"c":"Pl. Grg. 486a","u":"urn:cts:greekLit:tlg0059.tlg023:486a"},", etc.: hence arose the practice of using ",{"g":"δηλονότι"}," (q.v.) as Adv. "]],[3,"2",[" what we make the subject of the Verb which follows ",{"g":"ὅτι"}," freq. stands in the preceding clause, ",{"g":"Αυκάονας δὲ καὶ αὐτοὶ εἴδομεν, ὅτι . . καρποῦνται"}," (for ",{"g":"εἴδομεν, ὅτι Λυκάονες καρποῦνται"},") ",{"c":"X. An. 3.2.23","u":"urn:cts:greekLit:tlg0032.tlg006.perseus-grc1:3:2:23"},", cf. ",{"c":"3.2.29","u":"urn:cts:greekLit:tlg0032.tlg006.perseus-grc1:3:2:29"},", etc. "]],[2,"IV",[{"g":"ὅτι"}," sts.= with regard to the fact that, ",{"g":"ὅτι . . οὔ φησι . . ὄνομα εἶναι, ὑποπτεύω αὐτὸν σκώπτειν"},{"c":"Pl. Cra. 384c","u":"urn:cts:greekLit:tlg0059.tlg005.perseus-grc1:384c"},", cf. ",{"c":"Prt. 330e","u":"urn:cts:greekLit:tlg0059.tlg022:330e"},", etc. "]],[2,"V",[{"g":"οὐχ ὅ. . . , ἀλλὰ"}," or ",{"g":"ἀλλὰ καὶ . . , οὐχ ὅ. ὁ Κρίτων ἐν ἡσυχίᾳ ἦν, ἀλλὰ οἱ φίλοι αὐτοῦ"}," not only Crito.., but his friends, ",{"c":"X. Mem. 2.9.8","u":"urn:cts:greekLit:tlg0032.tlg002.perseus-grc1:2:9:8"},"; more fully, ",{"g":"οὐ μόνον ὅ. ἄνδρες, ἀλλὰ καὶ αἱ γυναῖκες"},{"c":"Pl. Smp. 179b","u":"urn:cts:greekLit:tlg0059.tlg011.perseus-grc1:179b"},": so folld. by ",{"g":"ἀλλ' οὐδὲ . . , ταύτῃ ἀδύνατα ἐξισοῦσθαι οὐχ ὅ. τὰ ἐν τῇ Εὐρώπῃ, ἀλλ' οὐδ' ἐν τῇ Ἀσίᾳ"}," not only the powers in Europe, but.., ",{"c":"Th. 2.97","u":"urn:cts:greekLit:tlg0003.tlg001.perseus-grc1:2:97"},": ",{"g":"οὐχ ὅ"},"., not folld. by a second clause, means although, ",{"g":"οὐχ ὅ. παίζει καί φησι"},{"c":"Pl. Prt. 336d","u":"urn:cts:greekLit:tlg0059.tlg022:336d"},", cf. ",{"c":"Grg. 450e","u":"urn:cts:greekLit:tlg0059.tlg023:450e"},", ",{"c":"Tht. 157b","u":"urn:cts:greekLit:tlg0059.tlg006.perseus-grc1:157b"},"; cf. ",{"g":"ὅπως"}," A. II. 2. "]],[3,"2",[" for ",{"g":"ὅτι μή"},", v. ",{"g":"ὅ τι"}," 11. "]],[1,"B",[" as a causal Particle, for that, because, generally after Verbs of feeling, ",{"c":"Il. 1.56","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:1:56"},", ",{"c":"14.407","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:14:407"},", al.; ",{"g":"οὐδὲν ἐκπλαγείς, ὅτι . . εἶδες"},{"c":"Jul.