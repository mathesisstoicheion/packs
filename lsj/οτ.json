6.tlg001.perseus-grc1:5:99"},", ",{"c":"Th. 1.8","u":"urn:cts:greekLit:tlg0003.tlg001.perseus-grc1:1:8"},", etc.; ",{"g":"ὅτε πέρ τε"},{"c":"Il. 4.259","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:4:259"},", ",{"c":"10.7","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:10:7"},". "]],[2,"IV",[" the proper correl. Adv. is ",{"g":"τότε"},", as ",{"g":"ὅ. δὴ . . , τότε δὴ"},".. ",{"c":"10.365","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:10:365"},"; ",{"g":"ὅ. δή ῥ' . . , δὴ τότε"},{"c":"23.721","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:23:721"},"; ",{"g":"ὅ. δὴ . . , καὶ τότε δὴ"},".. ",{"c":"22.208","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:22:208"},"; ",{"g":"ὅ. δή ῥα . . , καὶ τότ' ἄρ'"},{"c":"24.31","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:24:31"},": for ",{"g":"τότε"}," we sts. have ",{"g":"ἔπειτα"},", ",{"c":"3.221","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:3:221"},"; ",{"g":"αὐτίκα δ'"},", ",{"c":"4.210","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:4:210"},"; ",{"g":"δὲ"},".., ",{"c":"5.438","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:5:438"},"; also ",{"g":"νῦν . . , ὅ"},"... ",{"c":"S. Aj. 710","u":"urn:cts:greekLit:tlg0011.tlg003.perseus-grc1:710"}," (lyr.), etc.; ",{"g":"μεθύστερον, ὅ"},"... ",{"c":"Id. Tr. 711","u":"urn:cts:greekLit:tlg0011.tlg001.perseus-grc1:711"},"; ",{"g":"ἤματι τῷ, ὅ"},"... ",{"c":"Il. 2.743","u":"urn:cts:greekLit:tlg0012.tlg001.perseus-grc1:2:743"},", etc.; so in Att., ",{"g":"ἦν ποτε χρόνος, ὅ"},"... ",{"c":"Pl. Prt. 320c","u":"urn:cts:greekLit:tlg0059.tlg022:320c"},", cf. ",{"c":"Phd. 75a","u":"urn:cts:greekLit:tlg0059.tlg004.perseus-grc1:75a"},", ",{"c":"Hdt. 1.160","u":"urn:cts:greekLit:tlg0016.tlg001.perseus-grc1:1:160"},". "]],[3,"2",[" elliptical in the phrase ",{"g":"ἔστιν ὅ"},". or ",{"g":"ἔσθ' ὅ"},"., there are times when, sometimes, now and then, ",{"g":"ἔστι ὅ"},". ",{"c":"Id. 2.120","u":"urn:cts:greekLit:tlg0016.tlg001.perseus-grc1:2:120"},"; ",{"g":"ἔστιν ὅ"},". ",{