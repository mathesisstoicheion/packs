. 611","u":"urn:cts:greekLit:tlg0019.tlg007.perseus-grc1:611"},", ",{"c":"Ach. 516","u":"urn:cts:greekLit:tlg0019.tlg001.perseus-grc1:516"},".]"]]]}],"ὀτιαφόροι":[{"k":"o)tiafo/roi","s":"","b":[[0,"",[{"g":"ὀτιαφόροι:"},{"g":"οἱ τὰς ὀτίδας φέροντες ἐργάται:"}]]]}],"ὀτὶς":[{"k":"o)ti\\s","s":"","b":[[0,"",[{"g":"ὀτὶς"},{"g":"δὲ εἶδος ὄρνιθος"},", AB 287."]]]}],"ὁτιή":[{"k":"o(tih/","s":"because, 'cause why?, that","b":[[0,"",[{"g":"ὁτιή"}," (better ",{"g":"ὅτι ἢ,"}," v. infr.), Conj., colloquial form of ",{"g":"ὅτι"}," B, "]],[1,"A",[" because, ",{"c":"E. Cyc. 643","u":"urn:cts:greekLit:tlg0006.tlg001.perseus-grc1:643"},", ",{"c":"Eup. 305","u":"urn:cts:greekLit:tlg0461.tlg001:305"},", ",{"c":"Ar. Eq. 29","u":"urn:cts:greekLit:tlg0019.tlg002.perseus-grc1:29"},", ",{"c":"34","u":"urn:cts:greekLit:tlg0019.tlg002.perseus-grc1:34"},", ",{"c":"181","u":"urn:cts:greekLit:tlg0019.tlg002.perseus-grc1:181"},", ",{"c":"236","u":"urn:cts:greekLit:tlg0019.tlg002.perseus-grc1:236"},", etc.: folld. by ",{"g":"τί, ὁτιὴ τί"},"; 'cause why? ",{"c":"Id. Nu. 784","u":"urn:cts:greekLit:tlg0019.tlg003.perseus-grc1:784"},"; ",{"g":"ὁτιὴ τί δή"},"; ib.",{"c":"755","u":"urn:cts:greekLit:tlg0019.tlg003.perseus-grc1:755"},". (The accentuation ",{"g":"ὅτι ἢ"}," is implied by A.D., who says ",{"g":"πρὸς πάντων συμφώνως ἀνεγνώσθη ἐν ὀξείᾳ τάσει τὸ ο̄"},{"c":"Conj. 256.2","u":"urn:cts:greekLit:tlg0082.tlg003:256:2"},", cf. ",{"c":"Synt. 307.22","u":"urn:cts:greekLit:tlg0082.tlg004:307:22"},"; only ",{"g":"ὁτιὴ"}," is found in codd., and Eust. has ",{"g":"οἱ Ἀττικοὶ ὀξυτόνως λέγουσι τιὴ καὶ ὁτιή"},{"c":"118.36","u":"urn:cts:greekLit:tlg4083.tlg001:118:36"},", cf. ",{"c":"45.4","u":"urn:cts:greekLit:tlg4083.tlg001:45:4"},"; cf. ",{"g":"ἦ"},{"c":"1.2","u":"urn:cts:greekLit:tlg4083.tlg001:1:2"},".) "]],[3,"2",[" more rarely, = ",{"g":"ὅτι"},", that, ",{"c":"Ar. Eq. 360","u":"urn:cts:greekLit:tlg0019.tlg002.perseus-grc1:360"},", ",{"c":"Nu. 331","u":"urn:cts:greekLit:tlg0019.tlg003.perseus-grc1:331"},